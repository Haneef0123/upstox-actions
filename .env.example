# Bitbucket Configuration
BITBUCKET_BASE_URL=https://your-bitbucket-domain.com
BITBUCKET_USERNAME=your-username
BITBUCKET_APP_PASSWORD=your-app-password

# AI Configuration
# Provider: 'groq' or 'openai'
AI_PROVIDER=groq
AI_API_KEY=your-api-key
# Model for Groq: mixtral-8x7b-32768, llama-3.1-70b-versatile, etc.
# Model for OpenAI: gpt-4-turbo-preview, gpt-3.5-turbo, etc.
AI_MODEL=mixtral-8x7b-32768

# Slack Configuration
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
SLACK_DEFAULT_CHANNEL=#pr-reviews

# Processing Configuration
# Number of files to include in each batch for AI review
FILES_PER_BATCH=10
# Maximum number of commits to include in review context
MAX_COMMITS_PER_REVIEW=10
# Maximum length of a single Slack message before chunking
SLACK_MESSAGE_MAX_LENGTH=2800
# Concurrent batch processing limit
BATCH_CONCURRENCY=3

# Cron Configuration
# Cron expression for PR description generation (default: every 15 minutes)
CRON_PR_DESCRIPTION_INTERVAL=*/15 * * * *
# Secret token for authenticating cron requests
CRON_SECRET=your-random-secret-token

# Repository Configuration
# Comma-separated list of repositories to include (format: PROJECT/REPO)
REPOS_WHITELIST=PROJECT1/repo1,PROJECT2/repo2
# Comma-separated list of repositories to exclude
REPOS_BLACKLIST=

# Optional: Next.js Configuration
# NEXT_PUBLIC_APP_URL=http://localhost:3000
